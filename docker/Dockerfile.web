# ── Next.js dashboard (standalone output) ───────────────────────────────────
FROM node:22-alpine AS base
RUN corepack enable && apk add --no-cache libc6-compat
WORKDIR /app

FROM base AS builder
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @gitweave/web run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN apk add --no-cache tini curl && addgroup -S gw && adduser -S gw -G gw
# Standalone traces workspace packages from the repo root, so paths are nested.
COPY --from=builder --chown=gw:gw /app/apps/web/.next/standalone ./
COPY --from=builder --chown=gw:gw /app/apps/web/.next/static ./apps/web/.next/static
USER gw
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/web/server.js"]
